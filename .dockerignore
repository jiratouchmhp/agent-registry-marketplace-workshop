# Keep Docker build contexts lean for Cloud Build (`cloudbuild/*.yaml`) and
# optional local builds, retaining only runtime/build inputs (`middleware/`,
# `schemas/`, `samples/`, `cloudbuild/`, `pyproject.toml`).

# Ignore files & Git metadata
.git/
.gitignore
.gcloudignore
.dockerignore

# Python virtualenvs, caches & build artifacts
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
dist/
build/

# Terraform IaC, local state & variable files
terraform/
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars

# Workshop docs, tests, starter exercises, local skills & CLI tools
docs/
tests/
starter/
starter-marketplace/
local-skills/
security-governance/
mock_registry/
platform_agent/
tools/
scripts/
.agents/
.acme-agent-hub/

# Local archives, secrets & OS files
*.zip
.env
.env.*
.DS_Store
README.md
Makefile
WORKSHOP_SPEC.json
